diff -ruN a/plugins/m52xq-speakerphone-quick-setting/m52xq-speakerphone-quick-setting.c b/plugins/m52xq-speakerphone-quick-setting/m52xq-speakerphone-quick-setting.c
--- a/plugins/m52xq-speakerphone-quick-setting/m52xq-speakerphone-quick-setting.c	1970-01-01 02:00:00.000000000 +0200
+++ b/plugins/m52xq-speakerphone-quick-setting/m52xq-speakerphone-quick-setting.c	2026-11-20 22:10:47.121253341 +0200
@@ -0,0 +1,155 @@
+/*
+ * Copyright (C) 2026 Asdlerto Korry
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "m52xq-speakerphone-quick-setting.h"
+
+/**
+ * PhoshM52xqSpeakerphoneQuickSetting:
+ *
+ * Samsung Galaxy M52 5G (m52xq): the "Speakerphone" app as a tile of the shade. A click runs
+ * /usr/local/bin/m52xq-speakerphone (during a Telegram call: earpiece -> loud speaker -> USB headset /
+ * Bluetooth headphones -> earpiece; outside a call it only shows a notification). The tile shows the
+ * route that m52xq-audio-route writes to $XDG_RUNTIME_DIR/m52xq-audio-route and is highlighted while a
+ * Telegram call is on ($XDG_RUNTIME_DIR/m52xq-voip-active of m52xq-voip-audio). Both files are watched
+ * with inotify (GFileMonitor): no polling.
+ */
+
+#define ROUTE_FILE  "m52xq-audio-route"
+#define CALL_FILE   "m52xq-voip-active"
+#define SPEAKERPHONE "/usr/local/bin/m52xq-speakerphone"
+
+struct _PhoshM52xqSpeakerphoneQuickSetting {
+  PhoshQuickSetting  parent;
+
+  PhoshStatusIcon   *info;
+  GFileMonitor      *monitor;
+  char              *route_path;
+  char              *call_path;
+};
+
+G_DEFINE_TYPE (PhoshM52xqSpeakerphoneQuickSetting, phosh_m52xq_speakerphone_quick_setting,
+               PHOSH_TYPE_QUICK_SETTING);
+
+
+static gboolean
+is_russian (void)
+{
+  const char * const *langs = g_get_language_names ();
+
+  return langs && langs[0] && g_str_has_prefix (langs[0], "ru");
+}
+
+
+static void
+update_ui (PhoshM52xqSpeakerphoneQuickSetting *self)
+{
+  g_autofree char *route = NULL;
+  gboolean ru = is_russian ();
+  gboolean in_call = g_file_test (self->call_path, G_FILE_TEST_EXISTS);
+  const char *info, *icon;
+
+  if (g_file_get_contents (self->route_path, &route, NULL, NULL))
+    g_strstrip (route);
+
+  if (g_strcmp0 (route, "earpiece") == 0) {
+    info = ru ? "Разговорный" : "Earpiece";
+    icon = "call-start-symbolic";
+  } else if (g_strcmp0 (route, "usb") == 0) {
+    info = ru ? "USB-гарнитура" : "USB headset";
+    icon = "audio-headset-symbolic";
+  } else if (g_strcmp0 (route, "bt") == 0) {
+    info = ru ? "Bluetooth" : "Bluetooth";
+    icon = "bluetooth-active-symbolic";
+  } else {
+    info = ru ? "Громкая связь" : "Speakerphone";
+    icon = "audio-speakers-symbolic";
+  }
+
+  g_object_set (self->info, "icon-name", icon, "info", info, NULL);
+  g_object_set (self, "active", in_call, NULL);
+}
+
+
+static void
+on_runtime_dir_changed (PhoshM52xqSpeakerphoneQuickSetting *self,
+                        GFile                              *file,
+                        GFile                              *other_file,
+                        GFileMonitorEvent                   event,
+                        GFileMonitor                       *monitor)
+{
+  g_autofree char *name = g_file_get_basename (file);
+  g_autofree char *other = other_file ? g_file_get_basename (other_file) : NULL;
+
+  /* m52xq-audio-route writes a temporary file and renames it over the route file */
+  if (g_strcmp0 (name, ROUTE_FILE) == 0 || g_strcmp0 (name, CALL_FILE) == 0 ||
+      g_strcmp0 (other, ROUTE_FILE) == 0)
+    update_ui (self);
+}
+
+
+static void
+on_clicked (PhoshM52xqSpeakerphoneQuickSetting *self)
+{
+  g_autoptr (GError) err = NULL;
+  const char *argv[] = { SPEAKERPHONE, NULL };
+
+  if (!g_spawn_async (NULL, (char **) argv, NULL, G_SPAWN_DEFAULT, NULL, NULL, NULL, &err))
+    g_warning ("%s: %s", SPEAKERPHONE, err->message);
+}
+
+
+static void
+phosh_m52xq_speakerphone_quick_setting_finalize (GObject *object)
+{
+  PhoshM52xqSpeakerphoneQuickSetting *self = PHOSH_M52XQ_SPEAKERPHONE_QUICK_SETTING (object);
+
+  if (self->monitor)
+    g_file_monitor_cancel (self->monitor);
+  g_clear_object (&self->monitor);
+  g_clear_pointer (&self->route_path, g_free);
+  g_clear_pointer (&self->call_path, g_free);
+
+  G_OBJECT_CLASS (phosh_m52xq_speakerphone_quick_setting_parent_class)->finalize (object);
+}
+
+
+static void
+phosh_m52xq_speakerphone_quick_setting_class_init (PhoshM52xqSpeakerphoneQuickSettingClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->finalize = phosh_m52xq_speakerphone_quick_setting_finalize;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/mobi/phosh/plugins/m52xq-speakerphone-quick-setting/qs.ui");
+  gtk_widget_class_bind_template_child (widget_class, PhoshM52xqSpeakerphoneQuickSetting, info);
+  gtk_widget_class_bind_template_callback (widget_class, on_clicked);
+}
+
+
+static void
+phosh_m52xq_speakerphone_quick_setting_init (PhoshM52xqSpeakerphoneQuickSetting *self)
+{
+  g_autoptr (GFile) dir = NULL;
+  g_autoptr (GError) err = NULL;
+  const char *rt = g_get_user_runtime_dir ();
+
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+  self->route_path = g_build_filename (rt, ROUTE_FILE, NULL);
+  self->call_path = g_build_filename (rt, CALL_FILE, NULL);
+
+  dir = g_file_new_for_path (rt);
+  self->monitor = g_file_monitor_directory (dir, G_FILE_MONITOR_WATCH_MOVES, NULL, &err);
+  if (self->monitor)
+    g_signal_connect_object (self->monitor, "changed", G_CALLBACK (on_runtime_dir_changed), self,
+                             G_CONNECT_SWAPPED);
+  else
+    g_warning ("monitor %s: %s", rt, err->message);
+
+  update_ui (self);
+}
