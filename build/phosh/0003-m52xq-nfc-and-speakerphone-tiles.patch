diff -ruN a/plugins/m52xq-nfc-quick-setting/m52xq-nfc-quick-setting.c b/plugins/m52xq-nfc-quick-setting/m52xq-nfc-quick-setting.c
--- a/plugins/m52xq-nfc-quick-setting/m52xq-nfc-quick-setting.c	1970-01-01 02:00:00.000000000 +0200
+++ b/plugins/m52xq-nfc-quick-setting/m52xq-nfc-quick-setting.c	2026-11-20 22:10:18.574015209 +0200
@@ -0,0 +1,195 @@
+/*
+ * Copyright (C) 2026 Asdlerto Korry
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "m52xq-nfc-quick-setting.h"
+
+#include <glib-unix.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+#include <linux/rfkill.h>
+
+/**
+ * PhoshM52xqNfcQuickSetting:
+ *
+ * Samsung Galaxy M52 5G (m52xq): turn NFC on and off through rfkill (/dev/rfkill, writable by the
+ * active local user through the uaccess ACL). The state comes from the rfkill events of /dev/rfkill:
+ * no polling, the phone is not woken up.
+ */
+
+struct _PhoshM52xqNfcQuickSetting {
+  PhoshQuickSetting  parent;
+
+  PhoshStatusIcon   *info;
+  int                fd;
+  guint              watch_id;
+  GHashTable        *blocked;   /* rfkill idx -> blocked (soft or hard) */
+};
+
+G_DEFINE_TYPE (PhoshM52xqNfcQuickSetting, phosh_m52xq_nfc_quick_setting, PHOSH_TYPE_QUICK_SETTING);
+
+
+static gboolean
+is_russian (void)
+{
+  const char * const *langs = g_get_language_names ();
+
+  return langs && langs[0] && g_str_has_prefix (langs[0], "ru");
+}
+
+
+static gboolean
+any_blocked (PhoshM52xqNfcQuickSetting *self)
+{
+  GHashTableIter iter;
+  gpointer value;
+
+  g_hash_table_iter_init (&iter, self->blocked);
+  while (g_hash_table_iter_next (&iter, NULL, &value)) {
+    if (GPOINTER_TO_INT (value))
+      return TRUE;
+  }
+  return FALSE;
+}
+
+
+static void
+update_ui (PhoshM52xqNfcQuickSetting *self)
+{
+  gboolean present = g_hash_table_size (self->blocked) > 0;
+  gboolean on = present && !any_blocked (self);
+  gboolean ru = is_russian ();
+  const char *info;
+
+  if (!present)
+    info = ru ? "NFC недоступен" : "NFC unavailable";
+  else if (on)
+    info = "NFC";
+  else
+    info = ru ? "NFC выключен" : "NFC off";
+
+  g_object_set (self->info,
+                "icon-name", on ? "m52xq-nfc-symbolic" : "m52xq-nfc-disabled-symbolic",
+                "info", info,
+                NULL);
+  g_object_set (self, "active", on, NULL);
+  gtk_widget_set_sensitive (GTK_WIDGET (self), present);
+}
+
+
+static gboolean
+on_rfkill_event (int fd, GIOCondition condition, gpointer user_data)
+{
+  PhoshM52xqNfcQuickSetting *self = PHOSH_M52XQ_NFC_QUICK_SETTING (user_data);
+  struct rfkill_event ev;
+
+  if (condition & (G_IO_HUP | G_IO_ERR | G_IO_NVAL)) {
+    self->watch_id = 0;
+    return G_SOURCE_REMOVE;
+  }
+
+  for (;;) {
+    ssize_t n;
+
+    memset (&ev, 0, sizeof (ev));
+    n = read (fd, &ev, sizeof (ev));
+    if (n < 0) {
+      if (errno == EINTR)
+        continue;
+      break;                      /* EAGAIN: all events read */
+    }
+    if (n < RFKILL_EVENT_SIZE_V1)
+      break;
+    if (ev.type != RFKILL_TYPE_NFC)
+      continue;
+
+    switch (ev.op) {
+    case RFKILL_OP_ADD:
+    case RFKILL_OP_CHANGE:
+      g_hash_table_insert (self->blocked, GUINT_TO_POINTER (ev.idx + 1),
+                           GINT_TO_POINTER (ev.soft || ev.hard));
+      break;
+    case RFKILL_OP_DEL:
+      g_hash_table_remove (self->blocked, GUINT_TO_POINTER (ev.idx + 1));
+      break;
+    default:
+      break;
+    }
+  }
+
+  update_ui (self);
+  return G_SOURCE_CONTINUE;
+}
+
+
+static void
+on_clicked (PhoshM52xqNfcQuickSetting *self)
+{
+  struct rfkill_event ev;
+
+  if (self->fd < 0 || g_hash_table_size (self->blocked) == 0)
+    return;
+
+  memset (&ev, 0, sizeof (ev));
+  ev.op = RFKILL_OP_CHANGE_ALL;
+  ev.type = RFKILL_TYPE_NFC;
+  ev.soft = any_blocked (self) ? 0 : 1;   /* blocked -> unblock, on -> block */
+
+  if (write (self->fd, &ev, RFKILL_EVENT_SIZE_V1) < 0)
+    g_warning ("rfkill NFC %s: %s", ev.soft ? "block" : "unblock", g_strerror (errno));
+  /* the new state arrives as an rfkill event */
+}
+
+
+static void
+phosh_m52xq_nfc_quick_setting_finalize (GObject *object)
+{
+  PhoshM52xqNfcQuickSetting *self = PHOSH_M52XQ_NFC_QUICK_SETTING (object);
+
+  g_clear_handle_id (&self->watch_id, g_source_remove);
+  if (self->fd >= 0)
+    close (self->fd);
+  self->fd = -1;
+  g_clear_pointer (&self->blocked, g_hash_table_destroy);
+
+  G_OBJECT_CLASS (phosh_m52xq_nfc_quick_setting_parent_class)->finalize (object);
+}
+
+
+static void
+phosh_m52xq_nfc_quick_setting_class_init (PhoshM52xqNfcQuickSettingClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->finalize = phosh_m52xq_nfc_quick_setting_finalize;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/mobi/phosh/plugins/m52xq-nfc-quick-setting/qs.ui");
+  gtk_widget_class_bind_template_child (widget_class, PhoshM52xqNfcQuickSetting, info);
+  gtk_widget_class_bind_template_callback (widget_class, on_clicked);
+}
+
+
+static void
+phosh_m52xq_nfc_quick_setting_init (PhoshM52xqNfcQuickSetting *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+  gtk_icon_theme_add_resource_path (gtk_icon_theme_get_default (),
+                                    "/mobi/phosh/plugins/m52xq-nfc-quick-setting/icons");
+
+  self->blocked = g_hash_table_new (NULL, NULL);
+  self->fd = open ("/dev/rfkill", O_RDWR | O_NONBLOCK | O_CLOEXEC);
+  if (self->fd < 0)
+    g_warning ("/dev/rfkill: %s", g_strerror (errno));
+  else
+    self->watch_id = g_unix_fd_add (self->fd, G_IO_IN | G_IO_HUP | G_IO_ERR, on_rfkill_event, self);
+
+  /* /dev/rfkill sends an ADD event for every device right after the open */
+  update_ui (self);
+}
