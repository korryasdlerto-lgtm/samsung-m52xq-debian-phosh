 static void
-cui_dialpad_size_allocate (GtkWidget *widget,
-                           int        width,
-                           int        height,
-                           int        baseline)
-{
-  CuiDialpad *self = CUI_DIALPAD (widget);
-  GtkRoot *root = gtk_widget_get_root (widget);
-
-  GTK_WIDGET_CLASS (cui_dialpad_parent_class)->size_allocate (widget, width, height, baseline);
-
-  if (root) {
-    int w = gtk_widget_get_width (GTK_WIDGET (root));
-    int h = gtk_widget_get_height (GTK_WIDGET (root));
-    gboolean landscape = w > h && h > 0 && h < 600;
-
-    if (landscape != self->landscape) {
-      self->landscape = landscape;
-      if (!self->layout_idle_id)
-        self->layout_idle_id = g_idle_add (layout_idle_cb, self);
+m52xq_decide (CuiDialpad *self)
+{
+  GdkRectangle geo;
+  gboolean landscape;
+
+  if (!self->m52xq_monitor)
+    return;
+  gdk_monitor_get_geometry (self->m52xq_monitor, &geo);
+  landscape = geo.width > geo.height && geo.height < 600;
+  if (landscape == self->landscape)
+    return;
+  g_debug ("m52xq: dialpad, screen %dx%d -> %s", geo.width, geo.height, landscape ? "landscape" : "portrait");
+  self->landscape = landscape;
+  if (!self->layout_idle_id)
+    self->layout_idle_id = g_idle_add (layout_idle_cb, self);
+}
+
+
+static void
+m52xq_on_geometry (GdkMonitor *monitor, GParamSpec *pspec, CuiDialpad *self)
+{
+  m52xq_decide (self);
+}
+
+
+static void
+m52xq_on_unrealize (GtkWidget *widget, CuiDialpad *self)
+{
+  if (self->m52xq_monitor) {
+    g_clear_signal_handler (&self->m52xq_geometry_handler, self->m52xq_monitor);
+    g_clear_object (&self->m52xq_monitor);
+  }
+}
+
+
+static void
+m52xq_on_realize (GtkWidget *widget, CuiDialpad *self)
+{
+  GtkNative *native = gtk_widget_get_native (widget);
+  GdkSurface *surface = native ? gtk_native_get_surface (native) : NULL;
+  GdkMonitor *monitor = NULL;
+
+  if (surface)
+    monitor = gdk_display_get_monitor_at_surface (gdk_surface_get_display (surface), surface);
+  if (!monitor) {
+    GListModel *list = gdk_display_get_monitors (gtk_widget_get_display (widget));
+
+    if (g_list_model_get_n_items (list) > 0) {
+      monitor = g_list_model_get_item (list, 0);
+      g_object_unref (monitor);  /* the list keeps it */
     }
   }
+  if (!monitor || monitor == self->m52xq_monitor)
+    return;
+  m52xq_on_unrealize (widget, self);
+  self->m52xq_monitor = g_object_ref (monitor);
+  self->m52xq_geometry_handler = g_signal_connect (monitor, "notify::geometry", G_CALLBACK (m52xq_on_geometry), self);
+  m52xq_decide (self);
 }
 
 
